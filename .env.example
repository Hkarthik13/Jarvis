# Groq API Key (Get yours from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Secret API Key to authenticate local clients
JARVIS_API_KEY=jarvis_secure_key_123

# LLM Model Configuration
# Options include: llama-3.3-70b-versatile, mixtral-8x7b-32768, etc.
LLM_MODEL=llama-3.3-70b-versatile

# Speech-to-Text Model Configuration
STT_MODEL=whisper-large-v3-turbo

# Text-to-Speech Voice Configuration
# Use 'edge-tts --list-voices' to find others.
TTS_VOICE=en-US-AnaNeural

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
